# Application runtime only. Never put real secrets in this file.
DEPLOYMENT_PROFILE=local
PROVIDER=apify
APIFY_API_TOKEN=
APIFY_ACTOR_ID=scrapercompany/google-flights-scraper
APIFY_ACTOR_BUILD=0.0.2
MONTHLY_PROVIDER_CHARGE_CAP_USD=5.00
PROVIDER_JOB_MAX_CHARGE_USD=0.10
LIVE_SPIKE_MAX_CHARGE_USD=0.50
# Public Auth configuration; publishable key is safe for the frontend.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_API_URL=
SUPABASE_URL=
# Restricted direct SQL roles, backend only. Copy actual project connection URLs.
DATABASE_URL=
WORKER_DATABASE_URL=
LIVE_PROVIDER_ENABLED=false
# Individual explicit searches only; returned rights may remain unknown. Batches stay off.
LIVE_REFERENCE_SEARCH_ENABLED=false
LIVE_REFERENCE_BATCH_ENABLED=false
PROVIDER_CONCURRENCY=2
PROVIDER_REQUEST_TIMEOUT_SECONDS=30
QUERY_CACHE_TTL_SECONDS=900
MONTHLY_PROVIDER_CALL_CAP=1000
LIVE_SPIKE_CALL_CAP=40
AUTONOMOUS_MONITORING_ENABLED=false
# Local-only Workflow filesystem world; managed hosting uses its own world.
WORKFLOW_TARGET_WORLD=local
WORKFLOW_LOCAL_DATA_DIR=data/workflow-local
WORKFLOW_LOCAL_BASE_URL=http://127.0.0.1:3000
WORKFLOW_LOCAL_RECOVER_ACTIVE_RUNS=true
# Optional project-contained staged build; keep the same value for build/start.
# FC_NEXT_DIST_DIR=data/preview-build-a
