# Proposed configuration only. Never put real secrets in this file.
DEPLOYMENT_PROFILE=local
PROVIDER=unconfigured
SEARCHAPI_API_KEY=
# Optional alternatives; do not configure or subscribe by default.
APIFY_API_TOKEN=
APIFY_ACTOR_ID=
SERPAPI_API_KEY=
# Public Auth configuration; publishable key is safe for the frontend.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_API_URL=
SUPABASE_URL=
# Restricted direct SQL roles, backend only. Copy actual project connection URLs.
DATABASE_URL=
WORKER_DATABASE_URL=
# Setup/migration only; never load into API or worker runtime.
MIGRATION_DATABASE_URL=
PROVIDER_CONCURRENCY=2
PROVIDER_REQUEST_TIMEOUT_SECONDS=30
QUERY_CACHE_TTL_SECONDS=900
MONTHLY_PROVIDER_CALL_CAP=1000
LIVE_SPIKE_CALL_CAP=40
AUTONOMOUS_MONITORING_ENABLED=false
